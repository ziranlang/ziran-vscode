{
  "name": "kryon-language",
  "displayName": "Kryon Language",
  "description": "Syntax highlighting and editor behavior for Kryon .kry files",
  "version": "0.1.1",
  "publisher": "kryonlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kryonlabs/kryon-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kryon",
        "aliases": [
          "Kryon",
          "kry"
        ],
        "extensions": [
          ".kry"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kryon",
        "scopeName": "source.kryon",
        "path": "./syntaxes/kryon.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
