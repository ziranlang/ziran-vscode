{
  "name": "ziran-language",
  "displayName": "Ziran Language",
  "description": "Ziran language support and live Kryon project preview",
  "version": "0.4.0",
  "publisher": "kryonlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kryonlabs/kryon-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onLanguage:ziran",
    "onCommand:kryon.preview",
    "workspaceContains:kryon.toml",
    "onCustomEditor:ziran.zirViewer"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "ziran.zirViewer",
        "displayName": "Ziran Checked Module",
        "selector": [
          {
            "filenamePattern": "*.zir"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "kryon.preview",
        "title": "Kryon: Preview",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kryon.preview",
          "when": "resourceExtname == .zi",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Ziran",
      "properties": {
        "ziran.kryonCommand": {
          "type": "string",
          "default": "",
          "description": "Path to the kryon launcher for project previews. Empty uses ~/.local/bin/kryon when present, then PATH."
        },
        "ziran.previewProfile": {
          "type": "string",
          "default": "",
          "description": "Kryon project profile to preview. Empty uses the project's default profile."
        },
        "ziran.inspectorCommand": {
          "type": "string",
          "default": "",
          "description": "Path to the ziran command used to inspect .zir files. Empty finds the project's Ziran checkout."
        },
        "ziran.modulePaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional module directories, relative to a workspace folder or absolute. Workspace modules and a sibling Ziran std directory are found automatically."
        }
      }
    },
    "languages": [
      {
        "id": "ziran",
        "aliases": [
          "Ziran",
          "zi"
        ],
        "extensions": [
          ".zi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ziran",
        "scopeName": "source.ziran",
        "path": "./syntaxes/ziran.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
