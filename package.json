{
  "name": "ziran-language",
  "displayName": "Ziran Language",
  "description": "Ziran syntax highlighting and automatic module import navigation",
  "version": "0.2.0",
  "publisher": "kryonlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kryonlabs/kryon-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.cjs",
  "activationEvents": ["onLanguage:ziran"],
  "contributes": {
    "configuration": {
      "title": "Ziran",
      "properties": {
        "ziran.modulePaths": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Additional module directories, relative to a workspace folder or absolute. Workspace modules and a sibling Ziran std directory are found automatically."
        }
      }
    },
    "languages": [
      {
        "id": "ziran",
        "aliases": [
          "Ziran",
          "zi"
        ],
        "extensions": [
          ".zi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ziran",
        "scopeName": "source.ziran",
        "path": "./syntaxes/ziran.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
