{
  "name": "ziran-language",
  "displayName": "Ziran Language",
  "description": "Ziran language support, generated code preview for every target, and Kryon project preview",
  "version": "0.6.0",
  "publisher": "kryonlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziranlang/ziran-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onLanguage:ziran",
    "onCommand:kryon.preview",
    "onCommand:ziran.run",
    "workspaceContains:kryon.toml",
    "onCustomEditor:ziran.zirViewer"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "ziran.zirViewer",
        "displayName": "Ziran Checked Module",
        "selector": [
          {
            "filenamePattern": "*.zir"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ziran.run",
        "title": "Ziran: Run",
        "icon": "$(play)"
      },
      {
        "command": "kryon.preview",
        "title": "Kryon: Preview",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ziran.run",
          "when": "resourceExtname == .zi && !ziran.kryonProject",
          "group": "navigation@0"
        },
        {
          "command": "kryon.preview",
          "when": "resourceExtname == .zi && ziran.kryonProject",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "kryon.preview",
          "when": "ziran.kryonProject"
        }
      ]
    },
    "configuration": {
      "title": "Ziran",
      "properties": {
        "ziran.command": {
          "type": "string",
          "default": "",
          "description": "Path to the ziran command used to check files, generate code, and inspect .zir files. Empty uses a Ziran checkout above the file or beside the workspace, then ~/.local/bin/ziran, then PATH."
        },
        "ziran.previewTargets": {
          "type": "array",
          "default": [
            "c",
            "cpp",
            "go",
            "rust",
            "plan9-c"
          ],
          "items": {
            "type": "string",
            "enum": [
              "c",
              "cpp",
              "go",
              "rust",
              "plan9-c"
            ]
          },
          "uniqueItems": true,
          "description": "Targets whose generated code the Run pane shows. The pane's checkboxes update this setting."
        },
        "ziran.modulePaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional module directories, relative to a workspace folder or absolute. Workspace modules and a sibling Ziran std directory are found automatically."
        },
        "ziran.kryonCommand": {
          "type": "string",
          "default": "",
          "description": "Path to the kryon launcher for project previews. Empty uses ~/.local/bin/kryon when present, then PATH."
        },
        "ziran.previewProfile": {
          "type": "string",
          "default": "",
          "description": "Kryon project profile to preview. Empty uses the project's default profile."
        }
      }
    },
    "languages": [
      {
        "id": "ziran",
        "aliases": [
          "Ziran",
          "zi"
        ],
        "extensions": [
          ".zi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ziran",
        "scopeName": "source.ziran",
        "path": "./syntaxes/ziran.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
