{
  "name": "Kryon",
  "scopeName": "source.kryon",
  "patterns": [
    {"include": "#strings"},
    {"include": "#directives"},
    {"include": "#comments"},
    {"include": "#declarations"},
    {"include": "#types"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#operators"}
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kryon",
          "begin": "\"",
          "end": "\"",
          "patterns": [{"name": "constant.character.escape.kryon", "match": "\\\\(?:[0-7]{1,3}|x[0-9a-fA-F]+|[\\\\\"'abfnrtv0])"}]
        },
        {
          "name": "string.quoted.single.kryon",
          "begin": "'",
          "end": "'",
          "patterns": [{"name": "constant.character.escape.kryon", "match": "\\\\(?:[0-7]{1,3}|x[0-9a-fA-F]+|[\\\\\"'abfnrtv0])"}]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.kryon",
          "match": "(?<!\\S)(#)(import|module|style|else_if|elif|if|else|endif|enum|assert|include)\\b",
          "captures": {
            "1": {"name": "punctuation.definition.directive.kryon"},
            "2": {"name": "keyword.control.directive.kryon"}
          }
        },
        {
          "name": "storage.modifier.kryon",
          "match": "#(?:private|export|extern|ui|slot|type|intrinsic|host|global|defined|const|attr)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {"name": "comment.line.number-sign.kryon", "match": "#.*$"},
        {"name": "comment.line.double-slash.kryon", "match": "//.*$"},
        {"name": "comment.block.kryon", "begin": "/\\*", "end": "\\*/"}
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z_0-9]*)(\\s*)(::)(?=\\s*(?:\\(|struct\\b|enum\\b|union\\b|#import\\b))",
          "captures": {
            "1": {"name": "entity.name.function.kryon"},
            "3": {"name": "keyword.operator.declaration.kryon"}
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z_0-9]*)(\\s*)(::)",
          "captures": {
            "1": {"name": "entity.name.constant.kryon"},
            "3": {"name": "keyword.operator.declaration.kryon"}
          }
        },
        {"name": "entity.name.function.call.kryon", "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"}
      ]
    },
    "types": {
      "patterns": [
        {"name": "storage.type.kryon", "match": "\\b(?:bool|char|int|float|double|void|size_t|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|string)\\b"},
        {"name": "storage.type.definition.kryon", "match": "\\b(?:struct|enum|union|state)\\b"},
        {"name": "entity.name.type.kryon", "match": "\\b[A-Z][A-Za-z_0-9]*\\b"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.kryon", "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?)(?:[uUlLfF]*)\\b"}
      ]
    },
    "keywords": {
      "patterns": [
        {"name": "keyword.control.kryon", "match": "\\b(?:if|else|for|while|switch|case|default|break|continue|return|defer|goto|in)\\b"},
        {"name": "storage.modifier.kryon", "match": "\\b(?:const|static|extern|inline|unused)\\b"},
        {"name": "constant.language.kryon", "match": "\\b(?:true|false|nil|NULL)\\b"}
      ]
    },
    "operators": {
      "patterns": [
        {"name": "keyword.operator.kryon", "match": "(?:::|:=|->|==|!=|<=|>=|&&|\\|\\||[+*/%=!<>?:&|^-])"}
      ]
    }
  }
}
